<odoo>
<record id="permit_list" model="ir.ui.view"><field name="name">alasas.license.permit.list</field><field name="model">alasas.license.permit</field><field name="arch" type="xml"><list decoration-danger="days_left &lt; 0 and state != 'closed'" decoration-success="state == 'closed'"><field name="name"/><field name="asas_reference"/><field name="district"/><field name="user_id"/><field name="date_end"/><field name="days_left"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
<record id="permit_search" model="ir.ui.view"><field name="name">alasas.license.permit.search</field><field name="model">alasas.license.permit</field><field name="arch" type="xml"><search><field name="name"/><field name="asas_reference"/><field name="district"/><field name="user_id"/><filter name="my_permits" string="رخصي" domain="[('user_id', '=', uid)]"/><filter name="awaiting_lab" string="بانتظار المختبر" domain="[('state', '=', 'lab')]"/><filter name="closed" string="مغلقة" domain="[('state', '=', 'closed')]"/><filter name="state_group" string="حسب الحالة" context="{'group_by':'state'}"/><filter name="office_group" string="حسب المكتب" context="{'group_by':'office'}"/></search></field></record>
<record id="permit_form" model="ir.ui.view"><field name="name">alasas.license.permit.form</field><field name="model">alasas.license.permit</field><field name="arch" type="xml"><form>
<header><field name="state" widget="statusbar" statusbar_visible="draft,coordination,execution,lab,closure,closed"/></header>
<sheet><div class="oe_title"><h1><field name="name" placeholder="رقم الرخصة"/></h1></div>
<group><group string="بيانات الرخصة"><field name="asas_reference"/><field name="scheme"/><field name="office"/><field name="district"/><field name="street"/></group><group string="المتابعة"><field name="company_id" groups="base.group_multi_company"/><field name="user_id"/><field name="project_id"/><field name="task_id" domain="[('project_id', '=', project_id)]"/><field name="date_start"/><field name="date_end"/><field name="days_left"/><field name="active" invisible="1"/></group></group>
<notebook><page string="التنسيقات والموقع"><group><group><field name="state"/><field name="consultant_status"/><field name="center_status"/><field name="latitude"/><field name="longitude"/><field name="location_verified"/></group><group><field name="length_m"/><field name="width_m"/><field name="depth_m"/></group></group><field name="notes"/></page>
<page string="تقارير المختبر"><field name="lab_ids" context="{'default_permit_id': id}"><list><field name="name"/><field name="laboratory_id"/><field name="test_date"/><field name="result" widget="badge"/></list></field></page>
<page string="الإغلاقات"><field name="closure_ids" context="{'default_permit_id': id}"><list><field name="name"/><field name="lab_report_id"/><field name="state" widget="badge"/><field name="approved_by"/><field name="approved_at"/></list></field></page></notebook></sheet><chatter/></form></field></record>
<record id="permit_graph" model="ir.ui.view"><field name="name">alasas.license.permit.graph</field><field name="model">alasas.license.permit</field><field name="arch" type="xml"><graph string="الرخص حسب الحالة" type="bar"><field name="state"/></graph></field></record>
<record id="permit_pivot" model="ir.ui.view"><field name="name">alasas.license.permit.pivot</field><field name="model">alasas.license.permit</field><field name="arch" type="xml"><pivot string="تحليل الرخص"><field name="office" type="row"/><field name="state" type="col"/><field name="length_m" type="measure"/></pivot></field></record>
<record id="lab_list" model="ir.ui.view"><field name="name">alasas.license.lab.list</field><field name="model">alasas.license.lab</field><field name="arch" type="xml"><list><field name="name"/><field name="permit_id"/><field name="laboratory_id"/><field name="test_date"/><field name="result" widget="badge"/></list></field></record>
<record id="lab_form" model="ir.ui.view"><field name="name">alasas.license.lab.form</field><field name="model">alasas.license.lab</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="permit_id"/><field name="company_id" invisible="1"/><field name="laboratory_id"/><field name="test_date"/><field name="report_filename" invisible="1"/><field name="report_file" filename="report_filename"/><field name="result"/><field name="notes"/></group></sheet><chatter/></form></field></record>
<record id="closure_list" model="ir.ui.view"><field name="name">alasas.license.closure.list</field><field name="model">alasas.license.closure</field><field name="arch" type="xml"><list><field name="name"/><field name="permit_id"/><field name="lab_report_id"/><field name="state" widget="badge"/><field name="approved_by"/><field name="approved_at"/></list></field></record>
<record id="closure_form" model="ir.ui.view"><field name="name">alasas.license.closure.form</field><field name="model">alasas.license.closure</field><field name="arch" type="xml"><form><header><button name="action_approve" type="object" string="اعتماد الإغلاق" class="oe_highlight" groups="alasas_licensing.group_manager" invisible="state == 'approved'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="permit_id" readonly="state == 'approved'"/><field name="company_id" invisible="1"/><field name="lab_report_id" domain="[('permit_id', '=', permit_id), ('result', '=', 'pass')]" readonly="state == 'approved'"/><field name="state"/><field name="approved_by"/><field name="approved_at"/><field name="notes"/></group></sheet><chatter/></form></field></record>
<record id="action_permit" model="ir.actions.act_window"><field name="name">الرخص والتنسيقات</field><field name="res_model">alasas.license.permit</field><field name="view_mode">list,form,graph,pivot</field></record>
<record id="action_lab" model="ir.actions.act_window"><field name="name">تقارير المختبر</field><field name="res_model">alasas.license.lab</field><field name="view_mode">list,form</field></record>
<record id="action_closure" model="ir.actions.act_window"><field name="name">طلبات الإغلاق</field><field name="res_model">alasas.license.closure</field><field name="view_mode">list,form</field></record>
<record id="action_analysis" model="ir.actions.act_window"><field name="name">تحليل الرخص</field><field name="res_model">alasas.license.permit</field><field name="view_mode">graph,pivot,list,form</field></record>
<menuitem id="menu_licensing" name="التراخيص والتنسيقات والإغلاقات" sequence="12" groups="alasas_licensing.group_reader"/>
<menuitem id="menu_permits" name="الرخص والتنسيقات" parent="menu_licensing" action="action_permit" sequence="10"/>
<menuitem id="menu_lab" name="تقارير المختبر" parent="menu_licensing" action="action_lab" sequence="20"/>
<menuitem id="menu_closure" name="طلبات الإغلاق" parent="menu_licensing" action="action_closure" sequence="30"/>
<menuitem id="menu_analysis" name="لوحة التحليل" parent="menu_licensing" action="action_analysis" sequence="40"/>
</odoo>