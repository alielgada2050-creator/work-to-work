<odoo>
<record id="action_permit_pdf" model="ir.actions.report"><field name="name">ملخص الرخصة</field><field name="model">alasas.license.permit</field><field name="report_type">qweb-pdf</field><field name="report_name">alasas_licensing.permit_document</field><field name="report_file">alasas_licensing.permit_document</field><field name="binding_model_id" ref="model_alasas_license_permit"/><field name="binding_type">report</field></record>
<template id="permit_document"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page" dir="rtl"><h2>ملخص الرخصة — التراخيص والتنسيقات</h2><p>رقم الرخصة: <span t-field="o.name"/></p><p>رقم الأساس: <span t-field="o.asas_reference"/></p><p>الحالة: <span t-field="o.state"/></p><p>الحي: <span t-field="o.district"/></p><p>بداية الرخصة: <span t-field="o.date_start"/> — نهايتها: <span t-field="o.date_end"/></p><p>المسؤول: <span t-field="o.user_id"/></p><h3>تقارير المختبر</h3><table class="table table-sm"><thead><tr><th>التقرير</th><th>التاريخ</th><th>النتيجة</th></tr></thead><tbody><tr t-foreach="o.lab_ids" t-as="lab"><td><span t-field="lab.name"/></td><td><span t-field="lab.test_date"/></td><td><span t-field="lab.result"/></td></tr></tbody></table><h3>ملاحظات</h3><p t-field="o.notes"/><p class="text-muted">ملخص داخلي من النظام؛ لا يحل محل خطاب اعتماد الجهة المختصة.</p></div></t></t></t></template>
</odoo>