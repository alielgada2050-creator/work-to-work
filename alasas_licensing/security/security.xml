<odoo>
<record id="category_licensing" model="ir.module.category"><field name="name">التراخيص والتنسيقات</field></record>
<record id="privilege_licensing" model="res.groups.privilege"><field name="name">التراخيص</field><field name="category_id" ref="category_licensing"/></record>
<record id="group_reader" model="res.groups"><field name="name">قارئ الرخص</field><field name="privilege_id" ref="privilege_licensing"/><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record>
<record id="group_operator" model="res.groups"><field name="name">موظف الرخص</field><field name="privilege_id" ref="privilege_licensing"/><field name="implied_ids" eval="[(4, ref('group_reader'))]"/></record>
<record id="group_manager" model="res.groups"><field name="name">مدير الرخص</field><field name="privilege_id" ref="privilege_licensing"/><field name="implied_ids" eval="[(4, ref('group_operator'))]"/></record>
<record id="rule_permit_company" model="ir.rule"><field name="name">Licensing company isolation: permit</field><field name="model_id" ref="model_alasas_license_permit"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="rule_lab_company" model="ir.rule"><field name="name">Licensing company isolation: lab</field><field name="model_id" ref="model_alasas_license_lab"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="rule_closure_company" model="ir.rule"><field name="name">Licensing company isolation: closure</field><field name="model_id" ref="model_alasas_license_closure"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
</odoo>